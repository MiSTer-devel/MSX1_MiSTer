        <memory SHA1="4b4508131dca6d811694ae6379f41364c477de58" filename="ax370_swp.rom">ROM</memory>
      </block>
    </secondary>
    <secondary slot="3">
      <block start="1" count="2">  <!-- Sakhr BASIC -->
        <memory SHA1="8167117a003824220c36775682acbb36b3733c5e" filename="ax370_sb.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0" count="1">  <!-- MSX Sub ROM -->
        <memory SHA1="ee9c6a073766bef2220a57372f5c0dbfc6e55c8c" filename="ax370_msx2sub.rom">ROM</memory>
      </block>
      <block start="1" count="1">  <!-- Memory Mapped FDC -->
        <memory SHA1="9efa744be8355675e7bfdd3976bbbfaf85d62e1d" filename="ax370_disk.rom">ROM</memory>
        <device ioRegs="7FF8" fdd_count="1">TC8566AF</device>
      </block>
      <block start="2" count="1">  <!-- Memory Mapped FDC (registers) -->
        <ref to_block="1">DEVICE</ref>
      </block>
    </secondary>
    <secondary slot="1">
      <block start="0">  <!-- Painter -->
        <memory SHA1="1c9a5867d39f6f02a0a4ef291904623e2521c2c5" filename="ax370_painter.rom">ROM</memory>
      </block>
    </secondary>
    <secondary slot="3">
      <block start="0">  <!-- Main RAM -->
        <memory size="131072" pattern="1">RAM</memory>
        <mapper>MSX2_RAM</mapper>
        <device mask="0xFC" port="0xFC" size="131072">MEM_MAPPER</device>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
