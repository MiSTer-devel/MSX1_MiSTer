<?xml version="1.0" ?>
<!-- Daewoo CPC-61 Zemmix Super V (MSX2), converted from openMSX share/machines. -->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 --> 
  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFC" port="0x98" VDP_ID="V9938">V99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <device mask="0xFE" port="0xB4">RTC</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="dd3c39c8cfa06ec69f54c95c3b2291e3da7bd4f2" filename="CPC64122.ROM" size="32768">ROM</memory>
      </block>
    </secondary>
    <secondary slot="1">
      <block start="1" count="1">  <!-- MSX Hangul Driver -->
        <memory SHA1="dd3c39c8cfa06ec69f54c95c3b2291e3da7bd4f2" filename="CPC64122.ROM" skip="0xC000" size="16384">ROM</memory>
      </block>
      <block start="2" count="1">  <!-- MSX Hangul Driver (mirror) -->
        <ref to_block="1">MEMORY</ref>
      </block>
    </secondary>
    <secondary slot="2">
      <block start="0">  <!-- Main RAM -->
        <memory size="65536" pattern="1">RAM</memory>
        <mapper>MSX2_RAM</mapper>
        <device mask="0xFC" port="0xFC" size="65536">MEM_MAPPER</device>
      </block>
    </secondary>
    <secondary slot="3">
      <block start="0" count="1">  <!-- MSX Sub ROM -->
        <memory SHA1="dd3c39c8cfa06ec69f54c95c3b2291e3da7bd4f2" filename="CPC64122.ROM" skip="0x8000" size="16384">ROM</memory>
      </block>
      <block start="1" count="1">  <!-- MSX Sub ROM (mirror) -->
        <ref to_block="0">MEMORY</ref>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
