<?xml version="1.0" ?>
<!-- Mitsubishi ML-F120 (MSX), converted from openMSX share/machines.
     Not in the core: PrinterPort. -->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 --> 
  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFE" port="0x98" MODE="NTSC">TMS99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="302afb5d8be26c758309ca3df611ae69cced2821" filename="ml-f120_basic-bios1.rom">ROM</memory>
      </block>
      <block start="2" count="2">  <!-- Main RAM -->
        <memory size="32768" pattern="1">RAM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="1" count="1">  <!-- ML-F120 firmware ROM -->
        <memory SHA1="21a9f60cb6370d0617ce54c42bb7d8e40a4ab560" filename="ml-f120_firmware.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <cart>B</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
