<?xml version="1.0" ?>
<!-- National CF-3300 (MSX), converted from openMSX share/machines.
     Not in the core: PrinterPort. -->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 --> 
  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFE" port="0x98" MODE="NTSC">TMS99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="c7a2c5baee6a9f0e1c6ee7d76944c0ab1886796c" filename="cf-3300_basic-bios1.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0">  <!-- Main RAM -->
        <memory size="65536" pattern="1">RAM</memory>
      </block>
    </secondary>
    <secondary slot="1">
      <block start="1" count="1">  <!-- Memory Mapped FDC -->
        <memory SHA1="f1525de4e0b60a6687156c2a96f8a8b2044b6c56" filename="cf-3300_disk.rom">ROM</memory>
        <device style="National" fdd_count="1">WD2793</device>
      </block>
      <block start="2" count="1">  <!-- Memory Mapped FDC (mirror) -->
        <ref to_block="1">MEMORY</ref>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <cart>B</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
