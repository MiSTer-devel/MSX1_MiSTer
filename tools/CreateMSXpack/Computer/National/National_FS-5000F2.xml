      </block>
      <block start="1" count="2">  <!-- MSX Kanji Driver -->
        <memory SHA1="3a9a942ed888dd641cddf8deada1879c454df3c6" filename="fs-5000f2_kanjibasic.rom">ROM</memory>
      </block>
    </secondary>
    <secondary slot="1">
