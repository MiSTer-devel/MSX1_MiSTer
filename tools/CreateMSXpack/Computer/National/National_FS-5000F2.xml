  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <device mask="0xFE" port="0xB4">RTC</device>
  <device mask="0xFE" port="0xD8" ROM_SHA1="5e872d5853698731a0ed22fb72dbcdfd59cd19c3">KANJI</device>
  <kbd_layout></kbd_layout>
  <primary slot="0" expander="1">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="59967765d6e9328909dee4dac1cbe4cf9d47d315" filename="fs-5000f2_basic-bios2.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
