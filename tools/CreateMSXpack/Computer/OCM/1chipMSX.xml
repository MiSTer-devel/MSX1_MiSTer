<?xml version="1.0" ?>
<!--
  1chipMSX (OCM / OCM-PLD by KdL), behaves like MSX_MiSTer (MiSTer-devel).
  Boot: IPL ROM (slot 3-3 page 0, mapper OCM_IPL, visible until the first write to A8h)
  loads OCM-BIOS.DAT (512 kB) from the SD card (VHD) into ESE-RAM (slot 3-2).
  MAIN/XBASIC/OPLL/EXT/FREE ROMs are windows into ESE-RAM.
  ESE-RAM offsets (MSX_MiSTer emsx_top.vhd, SDRAM 600000h + offset):
    20000 MAIN 32k   28000 XBASIC 16k   2C000 OPLL 16k   30000 EXT+Kanji BASIC 48k
    3C000 FREE 16k   40000 Kanji font JIS1+JIS2 256k (KANJI device, shared_*)
  Slot 3 expander after reset 2Bh: page 0 = 3-3 (IPL), page 1/2 = 3-2, page 3 = 3-0.
  Primary slot 3 must come first and subslot 3-2 before 3-1/3-3 and slot 0:
  shared_memory references an already created block.
-->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 -->
  <wait_count>1</wait_count>       <!-- one M1 wait, as OCM -->
  <cpu_frequency>0</cpu_frequency> <!-- 3.58 MHz; turbo is switched at run time by OCM -->
  <kbd_layout></kbd_layout>

  <device mask="0xFC" port="0x98" VDP_ID="V9958">V99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8" OCM="true">PPI</device>
  <device mask="0xFE" port="0xB4">RTC</device>
  <device mask="0xFE" port="0x7C">OPLL</device>
  <device mask="0xFF" port="0xF4" inverted="true">RESET_STATUS</device>
  <device mask="0xFE" port="0xE6">SYSTIMER</device>         <!-- S1990 system timer -->
  <device mask="0xFC" port="0xD8" shared_slot="3" shared_subslot="2" shared_block="1" shared_offset="0x40000" shared_size="262144">KANJI</device>
  <device>OCM_BOOT</device>       <!-- switched I/O ports 40h-4Fh, IPL phase (ocm.sv) -->

  <primary slot="3" expander_init="0x2B">
    <secondary slot="0"> <!-- RAM mapper 4096 kB (MEM_MAPPER size 0 = 256 segments) -->
      <block>
        <memory size="4194304" pattern="4">RAM</memory>
        <mapper>MSX2_RAM</mapper>
        <device mask="0xFC" port="0xFC">MEM_MAPPER</device>
      </block>
    </secondary>
    <secondary slot="2"> <!-- ESE-RAM 512 kB + MegaSD -->
      <block start="1" count="2">
        <memory size="524288" pattern="4">RAM</memory>
        <mapper>ESE_RAM</mapper>
      </block>
    </secondary>
    <secondary slot="1"> <!-- EXT ROM + Kanji BASIC -->
      <block start="0" count="3">
        <shared_memory slot="3" subslot="2" block="1" size="49152" offset="0x30000">ROM</shared_memory>
      </block>
    </secondary>
    <secondary slot="3"> <!-- IPL ROM (page 0, only before the BIOS is loaded) + XBASIC -->
      <block start="0" count="1">
        <memory SHA1="81966a221b25c2cf61fc1e5e65a0d76f1b2f8553" filename="ocm_iplrom.rom">ROM</memory> <!-- from MSX_MiSTer iplrom.vhd -->
        <mapper>OCM_IPL</mapper>
      </block>
      <block start="1" count="1">
        <shared_memory slot="3" subslot="2" block="1" size="16384" offset="0x28000">ROM</shared_memory>
      </block>
    </secondary>
  </primary>

  <primary slot="0">
    <secondary slot="0"> <!-- MAIN ROM -->
      <block start="0" count="2">
        <shared_memory slot="3" subslot="2" block="1" size="32768" offset="0x20000">ROM</shared_memory>
      </block>
    </secondary>
    <secondary slot="2"> <!-- OPLL (MSX-MUSIC) ROM -->
      <block start="1" count="1">
        <shared_memory slot="3" subslot="2" block="1" size="16384" offset="0x2C000">ROM</shared_memory>
      </block>
    </secondary>
    <secondary slot="3"> <!-- FREE ROM -->
      <block start="1" count="1">
        <shared_memory slot="3" subslot="2" block="1" size="16384" offset="0x3C000">ROM</shared_memory>
      </block>
    </secondary>
  </primary>

  <!-- Internal ESE-SCC / MegaRAM (emsx_top U31_1 / U31_2), always present. Active while
       Slot1Mode / Slot2Mode (OSD, port 42h, ocm.sv) is not 00, otherwise the slot is empty. -->
  <primary slot="1">
    <secondary slot="0"> <!-- ESE-SCC1 1 MB (Scc1Adr 19:0) -->
      <block start="1" count="2">
        <memory size="1048576">RAM</memory>
        <mapper>MEGARAM</mapper>
        <device>SCC</device>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0"> <!-- ESE-SCC2 / MegaRAM 2 MB -->
      <block start="1" count="2">
        <memory size="2097152">RAM</memory>
        <mapper>MEGARAM</mapper>
        <device>SCC</device>
      </block>
    </secondary>
  </primary>
</msxConfig>
