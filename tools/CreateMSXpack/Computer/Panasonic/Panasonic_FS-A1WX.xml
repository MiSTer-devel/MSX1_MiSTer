      </block>
    </secondary>
    <secondary slot="1">
      <block start="0" count="1">  <!-- MSX Sub ROM -->
        <memory SHA1="fe0254cbfc11405b79e7c86c7769bd6322b04995" filename="fs-a1wx_msx2psub.rom">ROM</memory>
