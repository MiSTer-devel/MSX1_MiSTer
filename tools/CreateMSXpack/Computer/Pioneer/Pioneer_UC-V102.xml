  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="c1e46c00f1e38fc9e0ab487bf0513bd93ce61f3f" filename="uc-v102_basic-bios2.rom">ROM</memory>
