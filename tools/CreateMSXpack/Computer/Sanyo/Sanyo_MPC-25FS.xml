<?xml version="1.0" ?>
<!-- Sanyo MPC-25FS (MSX2), converted from openMSX share/machines.
     Not in the core: PrinterPort. -->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 --> 
  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFC" port="0x98" VDP_ID="V9938">V99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <device mask="0xFE" port="0xB4">RTC</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="0081ea0d25bc5cd8d70b60ad8cfdc7307812c0fd" filename="mpc-25fs_basic-bios2.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0" count="1">  <!-- MSX Sub ROM -->
        <memory SHA1="b8e30d604d319d511cbfbc61e5d8c38fbb9c5a33" filename="mpc-25fs_msx2sub.rom">ROM</memory>
      </block>
      <block start="1" count="1">  <!-- MSX Sub ROM (mirror) -->
        <ref to_block="0">MEMORY</ref>
      </block>
      <block start="2" count="1">  <!-- MSX Sub ROM (mirror) -->
        <ref to_block="0">MEMORY</ref>
      </block>
      <block start="3" count="1">  <!-- MSX Sub ROM (mirror) -->
        <ref to_block="0">MEMORY</ref>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="1">
      <block start="1" count="1">  <!-- Memory Mapped FDC -->
        <memory SHA1="50f4098a77e7af7093e29cc8683d2b34b2d07b13" filename="mpc-25fs_disk.rom">ROM</memory>
        <device style="Philips" fdd_count="1" single_sided="true">WD2793</device>
      </block>
      <block start="0" count="1">  <!-- Memory Mapped FDC (registers) -->
        <ref to_block="1">DEVICE</ref>
      </block>
      <block start="2" count="1">  <!-- Memory Mapped FDC (registers) -->
        <ref to_block="1">DEVICE</ref>
      </block>
      <block start="3" count="1">  <!-- Memory Mapped FDC (registers) -->
        <ref to_block="1">DEVICE</ref>
      </block>
    </secondary>
    <secondary slot="2">
      <block start="0">  <!-- Main RAM -->
        <memory size="65536" pattern="1">RAM</memory>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
