  <device mask="0xF8" port="0xA8">PPI</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="5e7c8eab238712d1e18b0219c0f4d4dae180420d" filename="hb-201p_basic-bios1.rom">ROM</memory>
      </block>
      <block start="2" count="1">  <!-- Personal Data Bank -->
        <memory SHA1="e84d3ec7a595ee36b50e979683c84105c1871857" filename="hb-201p_firmware.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0">  <!-- Main RAM -->
        <memory size="65536" pattern="1">RAM</memory>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
