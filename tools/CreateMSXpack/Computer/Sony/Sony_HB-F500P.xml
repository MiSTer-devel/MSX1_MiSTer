<?xml version="1.0" ?>
<!-- Sony HB-F500P (MSX2), converted from openMSX share/machines.
     Not in the core: PrinterPort. -->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 --> 
  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFC" port="0x98" VDP_ID="V9938">V99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <device mask="0xFE" port="0xB4">RTC</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="0de3c802057560560a03d7965fcc4cff69f8575c" filename="hb-f500p_basic-bios2.rom">ROM</memory>
      </block>
      <block start="2" count="2">  <!-- Main RAM page 2, 3 -->
        <memory size="32768" pattern="1">RAM</memory>
      </block>
    </secondary>
    <secondary slot="1">
      <block start="0" count="1">  <!-- MSX Sub ROM -->
        <memory SHA1="3288894e1be6af705871499b23c85732dbc40993" filename="hb-f500p_msx2sub.rom">ROM</memory>
      </block>
      <block start="1" count="1">  <!-- Memory Mapped FDC -->
        <memory SHA1="1566532146fcfc28c707753777c66585dc12418a" filename="hb-f500p_disk.rom">ROM</memory>
        <device style="Sony" fdd_count="1">WD2793</device>
      </block>
      <block start="2" count="1">  <!-- Memory Mapped FDC (registers) -->
        <ref to_block="1">DEVICE</ref>
      </block>
    </secondary>
    <secondary slot="2">
      <block start="0" count="2">  <!-- Main RAM page 0, 1 -->
        <memory size="32768" pattern="1">RAM</memory>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <cart>B</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
