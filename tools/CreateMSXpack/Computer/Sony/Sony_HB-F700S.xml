<?xml version="1.0" ?>
<!-- Sony HB-F700S (MSX2), converted from openMSX share/machines.
     Not in the core: S1985, PrinterPort. -->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 --> 
  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFC" port="0x98" VDP_ID="V9938">V99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <device mask="0xFE" port="0xB4">RTC</device>
  <kbd_layout></kbd_layout>
  <primary slot="0" expander="1">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="4811956f878c3e03da46317f787cdc4bebc86f47" filename="hb-f700s_basic-bios2.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0" count="1">  <!-- MSX Sub ROM -->
        <memory SHA1="1e9a955943aeea9b1807ddf1250ba6436d8dd276" filename="hb-f700s_msx2sub.rom">ROM</memory>
      </block>
      <block start="1" count="1">  <!-- Memory Mapped FDC -->
        <memory SHA1="3376cf9dd2b1ac9b41bf6bf6598b33136e86f9d5" filename="hb-f700s_disk.rom">ROM</memory>
        <device style="Sony" fdd_count="1">WD2793</device>
      </block>
      <block start="2" count="1">  <!-- Memory Mapped FDC (registers) -->
        <ref to_block="1">DEVICE</ref>
      </block>
    </secondary>
    <secondary slot="3">
      <block start="0">  <!-- Main RAM -->
        <memory size="262144" pattern="5">RAM</memory>
        <mapper>MSX2_RAM</mapper>
        <device mask="0xFC" port="0xFC" size="262144">MEM_MAPPER</device>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <cart>B</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
