<?xml version="1.0" ?>
<!-- Sony HB-F9P (MSX2), converted from openMSX share/machines.
     Not in the core: S1985, PrinterPort. -->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 --> 
  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFC" port="0x98" VDP_ID="V9938">V99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <device mask="0xFE" port="0xB4">RTC</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="0de3c802057560560a03d7965fcc4cff69f8575c" filename="hb-f9p_basic-bios2.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0" count="1">  <!-- MSX Sub ROM -->
        <memory SHA1="7b4a96402847decfc110ff9eda713bdcd218bd83" filename="hb-f9p_msx2sub.rom">ROM</memory>
      </block>
      <block start="1" count="1">  <!-- Memovision 2 -->
        <memory SHA1="8cc1f7ceeef745bb34e80253971e137213671486" filename="hb-f9p_firmware2.rom">ROM</memory>
      </block>
    </secondary>
    <secondary slot="1">
      <block start="1" count="2">  <!-- Memovision 1 -->
        <memory SHA1="2d1880d1f5a6944fcb1b198b997a3d90ecd1903d" filename="hb-f9p_firmware.rom">ROM</memory>
      </block>
    </secondary>
    <secondary slot="2">
      <block start="0">  <!-- Main RAM -->
        <memory size="131072" pattern="2">RAM</memory>
        <mapper>MSX2_RAM</mapper>
        <device mask="0xFC" port="0xFC" size="131072">MEM_MAPPER</device>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <cart>B</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
