<?xml version="1.0" ?>
<!-- Sony HB-F9P Russian (MSX2), converted from openMSX share/machines.
     Not in the core: S1985, PrinterPort. -->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 --> 
  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFC" port="0x98" VDP_ID="V9938">V99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <device mask="0xFE" port="0xB4">RTC</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="7f440ec7295d889b097e1b66bf9bc5ce086f59aa" filename="hb-f9p_russian_basic-bios2.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0" count="1">  <!-- MSX Sub ROM -->
        <memory SHA1="a6d7b1fd4ee896ca7513d02c033fc9a8aa065235" filename="hb-f9p_russian_msx2sub.rom">ROM</memory>
      </block>
      <block start="1" count="1">  <!-- MSX Sub ROM (mirror) -->
        <ref to_block="0">MEMORY</ref>
      </block>
    </secondary>
    <secondary slot="2">
      <block start="0">  <!-- Main RAM -->
        <memory size="131072" pattern="1">RAM</memory>
        <mapper>MSX2_RAM</mapper>
        <device mask="0xFC" port="0xFC" size="131072">MEM_MAPPER</device>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <cart>B</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
