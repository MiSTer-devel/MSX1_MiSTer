        <memory SHA1="cdeb0ed8adecaaadb78d5a5364fd603238591685" filename="tpc-310_accessories.rom">ROM</memory>
      </block>
    </secondary>
    <secondary slot="2">
      <block start="0">  <!-- Accessories ROM -->
        <cart>B</cart>
      </block>
