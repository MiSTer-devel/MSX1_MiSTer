<?xml version="1.0" ?>
<!-- Toshiba HX-20E (MSX), converted from openMSX share/machines.
     Not in the core: PrinterPort. -->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 --> 
  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFE" port="0x98" MODE="PAL">TMS99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="829c00c3114f25b3dae5157c0a238b52a3ac37db" filename="hx-20E_basic-bios.rom">ROM</memory>
      </block>
      <block start="2" count="2">  <!-- Main RAM page 2, 3 -->
        <memory size="32768" pattern="1">RAM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0" count="2">  <!-- Main RAM page 0, 1 -->
        <memory size="32768" pattern="1">RAM</memory>
      </block>
    </secondary>
    <secondary slot="3">
      <block start="1" count="2">  <!-- Word Processor ROM -->
        <memory SHA1="9f7cfa932bd7dfd0d9ecaadc51655fb557c2e125" filename="hx-20E_wordprocessor.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <cart>B</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
