<?xml version="1.0" ?>
<!-- Toshiba HX-21 (MSX), converted from openMSX share/machines.
     Not in the core: PrinterPort. -->
<msxConfig>
  <cpu>Z80</cpu>                   <!-- Z80 --> 
  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFE" port="0x98" MODE="NTSC">TMS99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="01600d06d83072d4e757b29728555efde2c79705" filename="HX21-IC2.BIN">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0">  <!-- Main RAM -->
        <memory size="65536" pattern="1">RAM</memory>
      </block>
    </secondary>
    <secondary slot="3">
      <block start="1" count="2">  <!-- Software Utility ROM -->
        <memory SHA1="4e2ec9c0294a18a3ab463f182f9333d2af68cdca" filename="HX21-IC3.BIN">ROM</memory>
      </block>
      <block start="0" count="1">  <!-- Software Utility ROM (mirror) -->
        <ref to_block="2">MEMORY</ref>
      </block>
      <block start="3" count="1">  <!-- Software Utility ROM (mirror) -->
        <ref to_block="1">MEMORY</ref>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <cart>B</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
