  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="079c018739c37485f3d64ef2145a0267fce6e20e" filename="ax200_basic-bios1.rom">ROM</memory>
      </block>
      <block start="2" count="2">  <!-- Main RAM page 2, 3 -->
        <memory size="32768" pattern="1">RAM</memory>
      </block>
    </secondary>
    <secondary slot="2">
      <block start="0" count="2">  <!-- Main RAM page 0, 1 -->
        <memory size="32768" pattern="1">RAM</memory>
      </block>
    </secondary>
    <secondary slot="3">
