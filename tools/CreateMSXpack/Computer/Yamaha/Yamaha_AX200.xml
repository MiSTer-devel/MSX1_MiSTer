        <memory SHA1="7574cc5655805ea316011a8123b064917f06f83c" filename="ax200_arabic.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0">  <!-- Yamaha SFG-05 -->
        <memory SHA1="fcc385b90c65575e29fc009aa00b5120fc4c251a" filename="sfg-05.rom">ROM</memory>
        <mapper>YAMAHA_SFG</mapper>
        <device variant="YM2164">OPM</device>
        <device variant="SFG-05">YM2148</device>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <cart>B</cart>
      </block>
    </secondary>
