  <wait_count>1</wait_count>       <!-- 0 - 3 -->  
  <cpu_frequency>0</cpu_frequency> <!-- 0-3.58, 1-5.39, 2-10.7-->  
  <device mask="0xFC" port="0x98" VDP_ID="V9938">V99xx</device>
  <device mask="0xF8" port="0xA0" system="true">PSG</device>
  <device mask="0xF8" port="0xA8">PPI</device>
  <device mask="0xFE" port="0xB4">RTC</device>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" count="2">  <!-- MSX BIOS with BASIC ROM -->
        <memory SHA1="0f851ee7a1cf79819f61cc89e9948ee72a413802" filename="yis-503iiir_basic-bios2.rom">ROM</memory>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0" count="1">  <!-- MSX Sub ROM -->
        <memory SHA1="03bf6d2ac86f5c9ab618e155442787c700f99fed" filename="yis-503iiir_msx2sub.rom">ROM</memory>
      </block>
      <block start="1" count="1">  <!-- CP/M ROM -->
        <memory SHA1="f4f7a54cdf5a9dd6c59f7cb219c2c5eb0a00fa8a" filename="yis-503iiir_cpm.rom">ROM</memory>
      </block>
    </secondary>
    <secondary slot="2">
      <block start="0">  <!-- Main RAM -->
        <memory size="131072" pattern="1">RAM</memory>
        <mapper>MSX2_RAM</mapper>
        <device mask="0xFC" port="0xFC" size="131072">MEM_MAPPER</device>
      </block>
    </secondary>
  </primary>
  <!-- Location of external slots at the end of the XML definition -->
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <cart>A</cart>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <cart>B</cart>
      </block>
    </secondary>
  </primary>
</msxConfig>
